  },
  "tools": {
    "edit_file": {
      "args": [
        "filepath",
        "new_content",
        "start_line",
        "end_line"
      ],
      "billed": true,
      "purpose": "编辑（非检索）",
      "required": [
        "filepath"
      ]
    },
    "get_code_neighbors": {
      "args": [
        "edge_type",
        "max_neighbors",
        "node"
      ],
      "billed": true,
      "purpose": "图邻接扩展；需符号全名，返回邻居名字（无路径无行号）",
      "required": [
        "node"
      ]
    },
    "get_code_subgraph": {
      "args": [
        "nodes"
      ],
      "billed": true,
      "purpose": "候选间连接；返回节点名与边",
      "required": [
        "nodes"
      ]
    },
    "get_status": {
      "args": [],
      "billed": false,
      "purpose": "状态查询（不计 tool_calls）",
      "required": []
    },
    "read_file": {
      "args": [
        "end_line",
        "filepath",
        "start_line"
      ],
      "billed": true,
      "purpose": "确认候选；150 行 + 10000 字符双上限",
      "required": [
        "filepath"
      ]
    },
    "run_command": {
      "args": [
        "command"
      ],
      "billed": true,
      "purpose": "唯一可扩展的检索引擎（bash + 离线 Python）",
      "required": [
        "command"
      ]
    },
    "search_similar_code": {
      "args": [
        "k",
        "query"
      ],
      "billed": true,
      "purpose": "节点名字典查询；query 必须是已有符号名/后缀，不接受自然语言",
      "required": [
        "query"
      ]
    },
    "submit_patch": {
      "args": [],
      "billed": false,
      "purpose": "提交补丁（不计 tool_calls）",
      "required": []
    },
    "write_file": {
      "args": [
        "content",
        "filepath"
      ],
      "billed": true,
      "purpose": "写入新文件（非检索）",
      "required": [
        "filepath",
        "content"
      ]
    }
  }
}
