    "protocol_sha256": "418e5cb311a53e469988c85995d7a716d2bf1aa44a769cd182f2a61c5050e5fa",
    "protocol_newline_mode": "lf"
  },

  "execution_mode": {
    "synthetic_mode": false,
    "synthetic_mode_rule": "必须是 JSON 布尔（严格类型）。字符串 \"false\" / 整数一律 MODE_TYPE_INVALID。合成模式最多给 SYNTHETIC_ACCEPTED，且不得要求也不得伪造 G4。",
