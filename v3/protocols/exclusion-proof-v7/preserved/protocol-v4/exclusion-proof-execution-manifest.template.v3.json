{
  "schema_version": "v3-v2-exclusion-proof-execution-manifest-3",
  "supersedes": "v3-v2-exclusion-proof-execution-manifest-2",
  "purpose": "独立执行 manifest：承载一次实际执行的绑定值与声明，通过 protocol_sha256 引用冻结协议。被检清单的自述字段一律不参与验收结论。",
  "protocol_ref": {
