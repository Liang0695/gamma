      "present": false,
      "authorization_id": null,
      "file_bytes_sha256": null,
      "trust_anchor_sha256": null,
      "note": "授权来自清单之外的可信授权记录，并由调用方提供的信任锚校验；清单自填 true 不构成授权。"
    },
    "isolation_ready_claim": {
      "claimed": false,
      "evidence": []
    }
  },

  "binding": {
    "candidate": {
      "file_bytes_sha256": null,
      "byte_length": null,
      "newline_mode": null
    },
    "denylist": {
      "file_bytes_sha256": null,
      "byte_length": null,
      "newline_mode": null,
      "canonical_json_sha256": null,
      "denylist_schema_version": null
    },
    "validator": {
      "cli_entrypoint": "python -m v3.cli split",
      "import_closure": [],
      "file_set": [],
      "file_set_rule": "逐文件记录 path / file_bytes_sha256 / byte_length / newline_mode / git_blob_sha1。至少覆盖 v3/data/dedup.py、v3/common/errors.py、v3/common/canonical.py（或真实 CLI 入口的完整文件集）。缺项 ⇒ BINDING_INCOMPLETE。"
    },
    "snapshot": {
      "content_status": "not_obtained",
      "file_bytes_sha256": null,
      "byte_length": null
    }
  },

  "counts": {
    "candidate": {
      "records_raw_count": null,
      "records_effective_count": null,
      "records_rejected_count": null
    },
    "denylist": {
      "denylist_raw_count": null,
      "denylist_effective_count": null,
      "denylist_rejected_count": null,
      "denylist_duplicate_count": null,
      "denylist_cross_array_duplicate_count": null,
      "denylist_per_array": {
        "d_family_ids": {"raw_count": null, "effective_count": null, "duplicate_count": null},
        "h_family_ids": {"raw_count": null, "effective_count": null, "duplicate_count": null},
        "exposed_family_ids": {"raw_count": null, "effective_count": null, "duplicate_count": null}
      },
      "source_array_map_is_multi_valued": null
    },
    "result": {
      "intersection_count": null
    },
    "invariant": {
      "raw_equals_effective_plus_duplicate": null,
      "rule": "必须为 true；false 或缺失 ⇒ COUNT_INVARIANT_BROKEN。"
    }
  },

  "denominator_check": {
    "baseline_artifact_id": null,
    "baseline_file_bytes_sha256": null,
    "compared_denominators": [],
    "measured": {},
    "rule": "必须逐项声明对照了哪些冻结分母口径。未提供基线或未逐项核对 ⇒ DENOMINATOR_MISSING；实测低于基线 ⇒ DENOMINATOR_SHORTFALL。"
  },

  "records": {
    "computation_result": {
